# Copie para .env e ajuste. Nunca faça commit do .env.

# --- Banco (serviço db) ---
POSTGRES_USER=sala_web
# Troque a senha antes do primeiro "docker compose up" (ela só vale na criação do volume pgdata).
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=sala_web
# Porta do Postgres publicada só em 127.0.0.1 (localhost desta máquina), nunca na rede da escola.
DB_PORTA_HOST=5432
# Usado ao rodar o backend fora do Docker (no Compose é montado automaticamente com host "db"):
DATABASE_URL=postgresql+psycopg://sala_web:troque-esta-senha@localhost:5432/sala_web
# Formato do Neon (publicação, ADR-0009): conexão direta (sem "-pooler" no host), sempre com SSL.
# O valor real fica só no painel do Render, nunca aqui nem no repositório.
# DATABASE_URL=postgresql+psycopg://USUARIO:SENHA@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Pool de conexões (ticket 63; padrões entre parênteses). O Neon suspende o banco após ~5 min parado e derruba
# as conexões ociosas: a API recicla antes disso e testa cada conexão antes de usar.
# DB_POOL_TAMANHO=5          # conexões mantidas abertas (5)
# DB_POOL_EXTRA=5            # conexões extras em pico (5)
# DB_POOL_RECICLAR_S=240     # descarta conexões com mais de N segundos (240; menor que a suspensão do Neon)
# DB_CONEXAO_TIMEOUT_S=10    # espera máxima para abrir uma conexão (10; o Neon leva até alguns segundos para acordar)
# Testes do backend (opcional): banco separado. Sem esta variável, os testes usam o banco de
# DATABASE_URL com sufixo _teste (crie antes: createdb sala_web_teste).
# DATABASE_URL_TESTE=postgresql+psycopg://sala_web:troque-esta-senha@localhost:5432/sala_web_teste

# --- Backend ---
TZ=America/Sao_Paulo
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRA_MINUTOS=480
# Origens do site, separadas por vírgula: http(s)://host[:porta], sem caminho. A barra final é ignorada;
# "*" ou um endereço com caminho (ex.: /agenda) impedem a API de subir. As origens aceitas aparecem no log.
CORS_ORIGENS=http://localhost:5173
# Pasta das fotos antigas, só para importar (ADR-0010). As fotos novas ficam no banco; a API não grava aqui.
UPLOAD_DIR=./uploads
# Tamanho máximo da foto enviada (a foto guardada é reduzida: lado maior 1600 px, JPEG).
UPLOAD_MAX_MB=5
# Falhas de login de um mesmo IP (qualquer RM) que bloqueiam o IP por 5 min (padrão 20; ADR-0007).
# 0 desliga só esse teto (as 5 falhas por RM continuam); no Render use 0; ADR-0009 (lá todos os
# clientes chegam com o IP do balanceador, e o teto viraria um bloqueio de login para todo mundo).
# LOGIN_MAX_FALHAS_IP=20
# Só com proxy reverso (nginx) na frente do backend: IP do proxy, para o limite de login ver o IP real
# do cliente (ADR-0007). Sem proxy, deixe comentado. Nunca use "*".
# FORWARDED_ALLOW_IPS=172.18.0.10

# Admin inicial criado pelo seed (só se ainda não existir esse RM)
ADMIN_RM=admin
ADMIN_SENHA=troque-esta-senha-admin
ADMIN_NOME=Administrador

# --- Produção (Render) ---
# Guia: docs/publicacao.md. Os VALORES ficam só no painel do Render (Environment), nunca neste arquivo,
# no repositório, no render.yaml, em issues ou prints. Nomes usados lá:
#   DATABASE_URL        segredo: connection string do Neon (formato acima, com sslmode=require)
#   JWT_SECRET          segredo: botão "Generate" do Render (ou generateValue no render.yaml)
#   ADMIN_RM            RM do primeiro admin (ex.: admin)
#   ADMIN_SENHA         segredo: só para o seed criar o admin; apague depois da primeira troca de senha
#   ADMIN_NOME          Administrador
#   CORS_ORIGENS        endereço do site no Vercel, ex.: https://sala-web.vercel.app (sem barra no fim)
#   LOGIN_MAX_FALHAS_IP 0
#   TZ                  America/Sao_Paulo
#   JWT_EXPIRA_MINUTOS  480 (opcional)
#   UPLOAD_MAX_MB       5 (opcional)
# Não defina PORT (o Render define) nem UPLOAD_DIR (não há fotos antigas na nuvem).

# --- Frontend ---
# As variáveis VITE_* entram no build: no Docker, mudou alguma delas, rode "docker compose up --build".
VITE_API_URL=http://localhost:8000
# Limite da foto conferido no navegador antes do upload (o servidor confere de novo com UPLOAD_MAX_MB).
# Sem esta variável, o Compose usa o UPLOAD_MAX_MB acima; fora do Docker, o padrão é 5.
# VITE_UPLOAD_MAX_MB=5
