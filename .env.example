# Copie para .env e ajuste. Nunca faça commit do .env.

# --- Banco (serviço db) ---
POSTGRES_USER=sala_web
# Troque a senha antes do primeiro "docker compose up" (ela só vale na criação do volume pgdata).
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=sala_web
# Porta do Postgres publicada só em 127.0.0.1 (localhost desta máquina), nunca na rede da escola.
DB_PORTA_HOST=5432
# Usado ao rodar o backend fora do Docker (no Compose é montado automaticamente com host "db"):
DATABASE_URL=postgresql+psycopg://sala_web:troque-esta-senha@localhost:5432/sala_web
# Testes do backend (opcional): banco separado. Sem esta variável, os testes usam o banco de
# DATABASE_URL com sufixo _teste (crie antes: createdb sala_web_teste).
# DATABASE_URL_TESTE=postgresql+psycopg://sala_web:troque-esta-senha@localhost:5432/sala_web_teste

# --- Backend ---
TZ=America/Sao_Paulo
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRA_MINUTOS=480
CORS_ORIGENS=http://localhost:5173
UPLOAD_DIR=./uploads
UPLOAD_MAX_MB=5
# Só com proxy reverso (nginx) na frente do backend: IP do proxy, para o limite de login ver o IP real
# do cliente (ADR-0007). Sem proxy, deixe comentado. Nunca use "*".
# FORWARDED_ALLOW_IPS=172.18.0.10

# Admin inicial criado pelo seed (só se ainda não existir esse RM)
ADMIN_RM=admin
ADMIN_SENHA=troque-esta-senha-admin
ADMIN_NOME=Administrador

# --- Frontend ---
# As variáveis VITE_* entram no build: no Docker, mudou alguma delas, rode "docker compose up --build".
VITE_API_URL=http://localhost:8000
# Limite da foto conferido no navegador antes do upload (o servidor confere de novo com UPLOAD_MAX_MB).
# Sem esta variável, o Compose usa o UPLOAD_MAX_MB acima; fora do Docker, o padrão é 5.
# VITE_UPLOAD_MAX_MB=5
