# Copie para .env e ajuste. Nunca faça commit do .env.

# --- Banco (serviço db) ---
POSTGRES_USER=sala_web
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=sala_web
DB_PORTA_HOST=5432
# Usado ao rodar o backend fora do Docker (no Compose é montado automaticamente com host "db"):
DATABASE_URL=postgresql+psycopg://sala_web:troque-esta-senha@localhost:5432/sala_web

# --- Backend ---
TZ=America/Sao_Paulo
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRA_MINUTOS=480
CORS_ORIGENS=http://localhost:5173
UPLOAD_DIR=./uploads
UPLOAD_MAX_MB=5

# Admin inicial criado pelo seed (só se ainda não existir esse RM)
ADMIN_RM=admin
ADMIN_SENHA=troque-esta-senha-admin
ADMIN_NOME=Administrador

# --- Frontend ---
VITE_API_URL=http://localhost:8000
